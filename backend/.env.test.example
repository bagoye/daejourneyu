# 통합 테스트(npm run test:int)용 설정. 복사해서 backend/.env.test로 저장한다(.env.test는 커밋하지 않는다).
# 안전장치: 호스트가 localhost/127.0.0.1이 아니면 테스트가 시작 전에 중단된다 — 운영 DB를 TRUNCATE하지 않게.
TEST_DATABASE_URL="postgresql://test:test@127.0.0.1:54329/daejourneyu_test"
# (선택) 앱은 풀러(PgBouncer 트랜잭션 모드)를 거치고 마이그레이션만 직접 붙는 운영 구성을 재현할 때.
# 예: TEST_DATABASE_URL=...:6432/daejourneyu_it?pgbouncer=true, TEST_DIRECT_URL=...:54333/daejourneyu_it
# TEST_DIRECT_URL=""
