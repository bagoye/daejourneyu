# 로컬 개발: 이 파일을 복사해 backend/.env로 저장하고 값을 채운다.
# 배포(Railway 등): 아래 키를 그대로 호스팅 플랫폼의 환경변수로 등록한다.

# Supabase(또는 다른 Postgres) connection string. 로컬은 `npx prisma dev --name daejourneyu --detach`
# 실행 후 나오는 postgres://... 값을 쓴다(루트 CLAUDE.md "실행" 참고).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# 마이그레이션(prisma migrate) 전용 접속. schema.prisma가 env("DIRECT_URL")을 읽으므로 비워두면 migrate가 실패한다.
# 로컬은 DATABASE_URL과 같은 값, 운영(Supabase)은 세션 풀러(5432) 주소(docs/deployment.md 참고).
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
#
# 운영 DATABASE_URL에는 커넥션 풀 파라미터를 명시한다(docs/db-optimization/04-database-operations.md §1):
#   ...:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=10
#   - connection_limit: 인스턴스당 DB 연결 수. 미지정이면 Prisma 기본값(물리 코어 수 × 2 + 1)이라 호스트 사양에 따라
#     달라진다. 로컬 측정에서 10을 넘으면 처리량이 거의 늘지 않았다(10: 276rps, 20: 296rps).
#     인스턴스 수 × connection_limit이 Supabase 풀러 한도를 넘지 않게 정한다.
#   - pool_timeout(초): 연결을 기다리는 최대 시간. 넘으면 API가 503 + Retry-After로 응답한다.
#   - 앱은 최소 권한 역할(scripts/ops/create-app-role.sql)로, DIRECT_URL만 소유자 계정으로 붙는 구성을 권장한다.

# 느린 쿼리 로그 기준(ms). 기본 500, 0이면 끈다. 쿼리 문장과 소요 시간만 남고 파라미터 값은 남지 않는다.
SLOW_QUERY_MS="500"

# 공공데이터포털(data.go.kr) 서비스키 — TourAPI(관광정보)·대전시 반려동물 동반시설·기상청 날씨 등
PUBLIC_DATA_API_KEY=""

# AI 코스 추천(/api/ai/course-suggestion)에 사용. aistudio.google.com/apikey에서 무료로 발급.
GEMINI_API_KEY=""

# 이메일/비밀번호 로그인(JWT 서명)에 사용. 배포 환경마다 다른 값을 발급해서 쓸 것
# (이 값이 유출되면 누구나 남의 로그인 토큰을 위조할 수 있음).
JWT_SECRET=""

# 카카오 로그인. developers.kakao.com > 내 애플리케이션 > [앱] > [플랫폼 키] > [REST API 키] 상세에서 발급.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
# 카카오 개발자 콘솔의 "카카오 로그인 > Redirect URI"에 등록한 값과 정확히 일치해야 한다.
# 예: 로컬 http://localhost:4000/api/auth/kakao/callback
#     배포 https://<백엔드 도메인>/api/auth/kakao/callback
KAKAO_REDIRECT_URI=""

# 배포된 프론트(Vercel) 도메인. CORS 허용 + 카카오 로그인 완료 후 리다이렉트 목적지로 쓰인다.
# 미설정 시 로컬 기본값(http://localhost:3000)으로 동작한다.
FRONTEND_ORIGIN=""
