{
  "uid": "djy-postgres",
  "title": "DaeJourneyU — PostgreSQL",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["postgres", "daejourneyu"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "DB 접속 가능(pg_up)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "pg_up", "legendFormat": "{{role}}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "gauge", "title": "연결 사용률",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (role) (pg_stat_activity_count) / max by (role) (pg_settings_max_connections)", "legendFormat": "{{role}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.6 }, { "color": "red", "value": 0.8 }] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "버퍼 캐시 적중률(daejourneyu)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (role) (rate(pg_stat_database_blks_hit{datname=\"daejourneyu\"}[1m])) / clamp_min(sum by (role) (rate(pg_stat_database_blks_hit{datname=\"daejourneyu\"}[1m]) + rate(pg_stat_database_blks_read{datname=\"daejourneyu\"}[1m])), 1)", "legendFormat": "{{role}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "WAL 보관 실패(누적) / 마지막 보관 후 경과",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "pg_archiver_failed_count{role=\"primary\"}", "legendFormat": "실패" },
        { "refId": "B", "expr": "pg_archiver_seconds_since_last_archive{role=\"primary\"}", "legendFormat": "경과(초)" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "커밋/롤백 초당(TPS)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_xact_commit{datname=\"daejourneyu\"}[1m])", "legendFormat": "commit {{role}}" },
        { "refId": "B", "expr": "rate(pg_stat_database_xact_rollback{datname=\"daejourneyu\"}[1m])", "legendFormat": "rollback {{role}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "복제 재생 지연(바이트) — 장애 전환 시 잃을 수 있는 양",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "pg_replication_sender_replay_lag_bytes", "legendFormat": "{{application_name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "연결 상태별",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (role, state) (pg_stat_activity_count)", "legendFormat": "{{role}} {{state}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "교착(1분 증가) · 가장 오래 열린 트랜잭션(초)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "increase(pg_stat_database_deadlocks{datname=\"daejourneyu\"}[1m])", "legendFormat": "교착 {{role}}" },
        { "refId": "B", "expr": "pg_xact_oldest_seconds", "legendFormat": "최장 트랜잭션(초) {{role}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "쿼리별 DB 시간 상위 5(pg_stat_statements, 초/초)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "topk(5, rate(pg_stat_statements_seconds_total{datname=\"daejourneyu\"}[1m]))", "legendFormat": "queryid {{queryid}}" }]
    }
  ]
}
